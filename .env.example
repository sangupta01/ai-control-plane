# AI Control Plane — Environment Variables
# Copy this file to .env and fill in values before running locally.
# Do NOT commit .env to version control.

# -------------------------------------------------------------------
# Core
# -------------------------------------------------------------------

# Port for the API server (required)
PORT=8080

# Base path for the API server (required, must match proxy config)
BASE_PATH=/api

# -------------------------------------------------------------------
# Storage
# -------------------------------------------------------------------

# Path to the SQLite database file.
# On Replit this defaults to control_plane.db in the working dir (ephemeral).
# Locally, set this to a path inside data/ for persistence across restarts.
DB_PATH=./data/ai-control-plane.db

# -------------------------------------------------------------------
# Provider mode
# -------------------------------------------------------------------

# Controls which LLM backend is used.
#   mock   — deterministic mock responses, no API keys needed (default)
#   real   — call real LLM APIs; fall back to mock if key missing or call fails
#   hybrid — try real first, silently fall back to mock
PROVIDER_MODE=mock

# OpenAI API key — required for mock-gpt-4 and mock-gpt-3.5 in real/hybrid mode
OPENAI_API_KEY=

# Anthropic API key — required for mock-claude-* models in real/hybrid mode
ANTHROPIC_API_KEY=

# -------------------------------------------------------------------
# Defaults
# -------------------------------------------------------------------

# Default provider name (reserved for future multi-provider routing)
DEFAULT_PROVIDER=

# Default model when none is specified in a request
DEFAULT_MODEL=mock-gpt-4

# -------------------------------------------------------------------
# Dashboard (only needed when running the dashboard locally)
# -------------------------------------------------------------------

# Port for the Vite dev server
# PORT=3000        # uncomment and set a different value for dashboard

# Base path served by Vite
# BASE_PATH=/      # for local standalone dashboard
